# TerraAlert AI Environment Variables Template
# Copy this file to .env and replace placeholder values with secure credentials for production.

# JWT Secret Key for Auth Service (must be at least 256-bit base64/hex string)
JWT_SECRET=your_jwt_secret_key_here

# Initial Password for Default Admin User
ADMIN_INITIAL_PASSWORD=your_admin_initial_password_here

# MongoDB Connection URI (optional override, default: mongodb://mongodb:27017/terraalert)
# SPRING_DATA_MONGODB_URI=mongodb://mongodb:27017/terraalert

# Allowed CORS Origins (optional override, comma-separated)
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
